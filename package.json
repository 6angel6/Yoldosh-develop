{
  "name": "yoldosh",
  "version": "1.0.0",
  "private": true,
  "description": "Yoldosh ride-sharing backend",
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest",
    "start": "ts-node src/main.ts",
    "build": "tsc --build --verbose",
    "build:watch": "tsc --build --watch",
    "dev": "nodemon --exec ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,shared}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,shared}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,shared}/**/*.ts\"",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migrate:status": "sequelize db:migrate:status",
    "migrate:create": "sequelize-cli migration:generate --name",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "worker:notification": "ts-node src/workers/notificationWorker.ts",
    "worker:scheduled": "ts-node src/workers/scheduledJobWorker.ts",
    "worker:recurring": "ts-node src/workers/recurringJobWorker.ts",
    "worker:all": "ts-node src/workers/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevYoldosh/Yoldosh.git"
  },
  "keywords": [],
  "author": "ООО «Milliy Yoldosh»",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/DevYoldosh/Yoldosh/issues"
  },
  "homepage": "https://github.com/DevYoldosh/Yoldosh#readme",
  "devDependencies": {
    "@babel/register": "^7.28.3",
    "@clinic/bubbleprof": "^10.0.0",
    "@clinic/doctor": "^11.0.0",
    "@clinic/flame": "^13.0.0",
    "@paddle-js-models/ocr": "^4.1.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/k6": "^1.3.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.1",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
